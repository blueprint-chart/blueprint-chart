  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@iconify-json/fluent": "^1.2.39",
    "@playwright/test": "^1.58.2",
    "@stylistic/eslint-plugin": "^4",
    "eslint": "^9",
    "eslint-plugin-vue": "^10",
    "typescript": "^5.7",
    "typescript-eslint": "^8",
    "vue-eslint-parser": "^10.4.0"
  }
}
