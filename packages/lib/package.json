{
  "name": "@blueprint-chart/lib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate:parser": "peggy --format es -o src/dsl/grammar.js src/dsl/grammar.peggy",
    "prebuild": "pnpm run generate:parser",
    "pretest": "pnpm run generate:parser",
    "build": "vite build && vite build -c vite.lib.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.5",
    "chroma-js": "^3.2.0",
    "d3": "^7",
    "d3-blueprint": "^0.1.5",
    "d3-transition": "^3",
    "dayjs": "^1.11.19"
  },
  "devDependencies": {
    "peggy": "^4",
    "@types/chroma-js": "^3.1.2",
    "@types/d3": "^7",
    "jsdom": "^26",
    "typescript": "^5.7",
    "vite": "^6",
    "vitest": "^3"
  }
}
