{
  "name": "@blueprint-chart/lib",
  "version": "0.1.4",
  "description": "DSL-driven charting library built on D3. Define charts as text, render them anywhere.",
  "keywords": [
    "chart",
    "charts",
    "charting",
    "d3",
    "dsl",
    "visualization",
    "data-visualization"
  ],
  "license": "MIT",
  "author": "pirhoo",
  "homepage": "https://github.com/blueprint-chart/blueprint-chart#readme",
  "bugs": {
    "url": "https://github.com/blueprint-chart/blueprint-chart/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blueprint-chart/blueprint-chart.git",
    "directory": "packages/lib"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./charts.scss": "./src/charts/chart.scss",
    "./src/charts/chart.scss": "./src/charts/chart.scss"
  },
  "files": [
    "dist",
    "src/charts/chart.scss",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate:parser": "peggy --format es -o src/dsl/grammar.js src/dsl/grammar.peggy",
    "prebuild": "pnpm run generate:parser",
    "pretest": "pnpm run generate:parser",
    "build": "vite build && vite build -c vite.lib.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.5",
    "chroma-js": "^3.2.0",
    "d3": "^7",
    "d3-blueprint": "^0.1.7",
    "d3-transition": "^3",
    "dayjs": "^1.11.19"
  },
  "devDependencies": {
    "@types/chroma-js": "^3.1.2",
    "@types/d3": "^7",
    "jsdom": "^26",
    "peggy": "^4",
    "typescript": "^5.7",
    "vite": "^6",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^3"
  }
}
