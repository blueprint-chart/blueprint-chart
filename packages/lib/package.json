{
  "name": "@blueprint-chart/lib",
  "version": "1.8.0",
  "description": "DSL-driven charting library built on D3. Define charts as text, render them anywhere.",
  "keywords": [
    "chart",
    "charts",
    "charting",
    "d3",
    "dsl",
    "visualization",
    "data-visualization"
  ],
  "license": "MIT",
  "author": "pirhoo",
  "homepage": "https://github.com/blueprint-chart/blueprint-chart#readme",
  "bugs": {
    "url": "https://github.com/blueprint-chart/blueprint-chart/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blueprint-chart/blueprint-chart.git",
    "directory": "packages/lib"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal/node-backend": {
      "node": "./dist/node-backend/index.js",
      "browser": "./dist/node-backend/browser.js",
      "default": "./dist/node-backend/browser.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js",
      "default": "./dist/embed.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./charts.scss": "./src/charts/chart.scss",
    "./src/charts/chart.scss": "./src/charts/chart.scss",
    "./embed-runtime.js": "./dist/lib/lib.iife.js"
  },
  "files": [
    "dist",
    "src/charts/chart.scss",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate:parser": "peggy --format es -o src/dsl/grammar.js src/dsl/grammar.peggy",
    "prebuild": "pnpm run generate:parser",
    "pretest": "pnpm run generate:parser",
    "build": "vite build && vite build -c vite.lib.config.ts && vite build -c vite.node-backend.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "chroma-js": "^3.2.0",
    "d3": "^7.9.0",
    "d3-blueprint": "^0.1.7",
    "d3-transition": "^3.0.1",
    "dayjs": "^1.11.21"
  },
  "devDependencies": {
    "@types/chroma-js": "^3.1.2",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^21.1.7",
    "peggy": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "jsdom": "^26.1.0"
  }
}
