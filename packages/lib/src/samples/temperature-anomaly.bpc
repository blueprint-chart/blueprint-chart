chart line {
  title = "2024 was the hottest year on record"
  description = "Deviation from the 1951–1980 average, in °C"
  source = "NASA GISS"
  sourceUrl = "https://data.giss.nasa.gov/gistemp/"
  colorPalette = "Blueprint"
  autoContrast = false
  allowDarkMode = true
  interpolation = "monotoneX"
  showVerticalAxis = false
  verticalAxisDirection = "left"
  showVerticalTicks = false
  verticalLabelPosition = "auto"
  verticalGridStyle = "dashed"
  verticalScaleType = "linear"
  showHorizontalAxis = true
  showHorizontalTicks = false
  horizontalLabelPosition = "auto"
  horizontalGridStyle = "none"
  valueLabels = false
  tooltips = true
  crosshair = false
  crosshairDirection = "vertical"
  crosshairStyle = "dashed"
  crosshairColor = "#999"
  lineSymbols = true
  lineSymbolShape = "circle"
  lineSymbolShowOn = "firstLast"
  lineSymbolStyle = "filled"
  lineSymbolSize = "3.5"
  lineSymbolOpacity = "1"

  data {
    "1980" = 0.26
    "1985" = 0.12
    "1990" = 0.45
    "1995" = 0.45
    "2000" = 0.42
    "2005" = 0.68
    "2010" = 0.72
    "2015" = 0.9
    "2020" = 1.02
    "2024" = 1.29
  }

  annotation "2015" {
    id = "2o3cx"
    text = "2015 Paris Agreement to limit global warming to 1.5°C "
    maxWidth = 224
    showLine = true
    lineStyle = curve-right
    showArrow = true
    showCircle = true
  }
}
