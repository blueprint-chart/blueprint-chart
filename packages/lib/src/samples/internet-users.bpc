chart bar-horizontal {
  title = "China and India account for half the world's internet users"
  description = "Millions of users, 2024"
  source = "ITU / World Bank"
  sourceUrl = "https://data.worldbank.org"
  colorPalette = "Enara"
  sort = descending
  horizontalLabelPosition = off
  horizontalGridStyle = none

  highlight "China"

  data {
    "China" = 1050
    "India" = 900
    "United States" = 312
    "Indonesia" = 213
    "Brazil" = 186
    "Russia" = 130
    "Japan" = 118
    "Nigeria" = 110
  }
}
