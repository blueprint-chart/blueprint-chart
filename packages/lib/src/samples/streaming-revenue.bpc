chart bar-multi {
  title = "Spotify earns nearly three times Apple Music's revenue"
  description = "USD billions by platform"
  source = "IFPI / company reports"
  note = "Revenue figures are approximate annual estimates"
  colorPalette = "Deelite"
  legendPosition = "top"
  valueLabels = true
  tooltips = true

  data {
    _series = "Spotify,Apple Music,Amazon Music"
    "2021" = 11.4,4.1,2.3
    "2022" = 12.4,4.8,2.6
    "2023" = 14.3,5.4,3.0
    "2024" = 16.8,6.1,3.5
  }
}
