chart bar-vertical {
  title = "China emits more CO₂ than the US and India combined"
  description = "Annual emissions in billion tonnes, 2023"
  source = "Global Carbon Project"
  sourceUrl = "https://globalcarbonproject.org"
  colors = "#abb8c3"
  autoContrast = false
  allowDarkMode = true
  showVerticalAxis = false
  verticalAxisDirection = "left"
  showVerticalTicks = false
  verticalLabelPosition = "off"
  verticalGridStyle = "none"
  verticalScaleType = "linear"
  showHorizontalAxis = true
  showHorizontalTicks = false
  horizontalLabelPosition = "auto"
  horizontalGridStyle = "none"
  valueLabels = true
  valueLabelPosition = "auto"

  data {
    "China" = 11.9
    "United States" = 4.78
    "India" = 2.88
    "Russia" = 1.78
    "Japan" = 1.02
    "Germany" = 0.64
  }

  highlight "China" {
    color = "#e15759"
    label = "Largest emitter"
  }

  annotation "India" {
    text = "Surpassed EU in 2023"
    showLine = true
    anchorDirection = N
    textOffsetX = 66
    textOffsetY = -41
    lineStyle = curve-left
    showArrow = true
    lineTargetDistance = 26
    showCircle = false
  }
}
