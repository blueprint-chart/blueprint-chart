    "2021" = "2.91,2.56,1.39,1.00"
    "2022" = "2.96,2.68,1.48,1.20"
    "2023" = "3.05,2.70,2.00,1.56"
    "2024" = "3.07,2.53,2.35,1.69"
  }
}
