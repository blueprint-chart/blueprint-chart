chart bar-multi {
  title = "China's EV market is now triple the size of Europe's"
  description = "Million units sold"
  source = "IEA Global EV Outlook"
  sourceUrl = "https://iea.org"
  colorPalette = "Cancri"
  legendPosition = "top"
  tooltips = true

  data {
    _series = "China,Europe,United States"
    "2020" = 1.3,1.4,0.3
    "2021" = 3.3,2.3,0.6
    "2022" = 5.9,2.7,0.9
    "2023" = 8.1,3.2,1.4
    "2024" = 10.5,3.5,1.8
  }
}
