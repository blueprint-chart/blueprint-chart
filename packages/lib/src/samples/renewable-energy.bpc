chart line-multi {
  title = "Wind and solar are catching up to hydroelectric power"
  description = "Share of electricity generation by source (%)"
  source = "IEA"
  sourceUrl = "https://iea.org"
  note = "Wind and solar include both onshore and offshore installations"
  colors = "#59a14f, #edc949, #4e79a7"
  legend = false
  lineSymbols = true
  lineSymbolShowOn = "last"
  tooltips = true

  data {
    _series = "Hydro,Wind,Solar"
    "2010" = "16.0,1.6,0.3"
    "2012" = "16.2,2.4,0.6"
    "2014" = "16.3,3.3,1.1"
    "2016" = "16.4,4.0,1.5"
    "2018" = "15.8,4.8,2.4"
    "2020" = "16.8,6.2,3.7"
    "2022" = "15.0,7.8,4.5"
    "2024" = "14.8,9.5,6.2"
  }
}
