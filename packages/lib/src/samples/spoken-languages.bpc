chart bar-horizontal {
  title = "Mandarin has nearly twice as many native speakers as Spanish"
  description = "Number of native speakers worldwide, in millions"
  source = "Ethnologue"
  sourceUrl = "https://ethnologue.com"
  byline = "Pierre Romera"
  sort = descending

  highlight "Mandarin"

  data {
    "Mandarin" = 988
    "Spanish" = 487
    "English" = 372
    "Hindi" = 347
    "Bengali" = 232
    "Portuguese" = 252
    "Russian" = 133
    "Japanese" = 124
  }
}
