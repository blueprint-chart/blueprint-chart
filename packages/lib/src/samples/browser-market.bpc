chart donut {
  title = "Desktop Browser Market Share"
  description = "Worldwide, January 2025"
  source = "StatCounter"
  sourceUrl = "https://gs.statcounter.com"
  colorPalette = "Heep"
  legendPosition = "right"
  tooltips = true
  displayAsPercentage = true

  data {
    "Chrome" = 65.7
    "Edge" = 13.1
    "Safari" = 8.9
    "Firefox" = 6.3
    "Opera" = 3.1
    "Others" = 2.9
  }
}
