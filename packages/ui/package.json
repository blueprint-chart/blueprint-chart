    "@types/d3-time-format": "^4.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.4.0",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^0.45.10",
    "histoire": "^0.17.17",
    "jsdom": "^26.1.0",
    "sass": "^1.102.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
