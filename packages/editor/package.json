{
  "name": "@blueprint-chart/editor",
  "version": "1.6.0",
  "description": "Blueprint Chart editor — static site bundle. Self-host or use the live version at https://blueprintchart.com.",
  "keywords": [
    "blueprint-chart",
    "editor",
    "chart-editor"
  ],
  "license": "MIT",
  "author": "pirhoo",
  "homepage": "https://blueprintchart.com",
  "bugs": {
    "url": "https://github.com/blueprint-chart/blueprint-chart/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blueprint-chart/blueprint-chart.git",
    "directory": "packages/editor"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build:grammar": "node src/dsl-lang/build.mjs",
    "predev": "node src/dsl-lang/build.mjs",
    "dev": "vite",
    "build": "node src/dsl-lang/build.mjs && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "pretest": "node src/dsl-lang/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@blueprint-chart/lib": "workspace:*",
    "@blueprint-chart/ui": "workspace:*",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@supabase/supabase-js": "^2.112.2",
    "@vueuse/core": "^14.4.0",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^0.27.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@lezer/generator": "^1.8.0",
    "@pinia/testing": "^1.0.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^26.1.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
