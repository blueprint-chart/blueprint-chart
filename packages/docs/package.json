    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^14.2.1",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7",
    "unplugin-icons": "^23.0.1",
    "vitepress": "^1.5.0",
    "vitest": "^3.2.4",
    "vue": "^3.5"
  }
