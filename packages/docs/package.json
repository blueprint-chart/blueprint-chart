  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blueprint-chart/blueprint-chart.git",
    "directory": "packages/docs"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vitepress dev src --host 0.0.0.0 --port 4445",
