{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/exec", {
      "prepareCmd": "pnpm -r exec -- npm version ${nextRelease.version} --no-git-tag-version --allow-same-version && node scripts/verify-release-versions.mjs v${nextRelease.version}",
      "publishCmd": "pnpm -r publish --access public --no-git-checks --provenance"
    }],
    ["@semantic-release/github", { "successComment": false, "failComment": false }],
    ["@semantic-release/git", {
      "assets": ["CHANGELOG.md", "packages/*/package.json"],
      "message": "chore(release): v${nextRelease.version} [skip ci]"
    }]
  ]
}
